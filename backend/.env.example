DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_txn
SECRET_KEY=replace-me-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Without a key the categorizer still works using history + keyword rules;
# the LLM fallback is simply skipped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AUTO_CATEGORIZE_THRESHOLD=0.75

# Origins allowed to call the API from a browser (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
