# Where the FastAPI backend is reachable FROM THE PHONE (not "localhost" on a real device):
#   Android emulator -> http://10.0.2.2:8000     iOS simulator -> http://localhost:8000
#   Real phone       -> http://<your computer's LAN IP>:8000   (start uvicorn with --host 0.0.0.0)
EXPO_PUBLIC_API_URL=http://localhost:8000
