    {
      "name": "3. Transactions",
      "item": [
        {
          "name": "Create - auto-categorized (no category_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 450,\n  \"type\": \"expense\",\n  \"description\": \"Swiggy order\",\n  \"payment_method\": \"UPI\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "No category_id: the AI layer picks one. 'swiggy' hits the keyword rules -> Food."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"categorized as Food by a rule\", () => { pm.expect(j.category.name).to.eql(\"Food\"); pm.expect(j.category_source).to.eql(\"rule\"); });",
                  "pm.test(\"amount is exact\", () => { pm.expect(j.amount).to.eql(\"450.00\"); });",
                  "pm.collectionVariables.set(\"txnId\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create - explicit category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500,\n  \"type\": \"expense\",\n  \"description\": \"Amazon order\",\n  \"category_id\": \"{{shoppingId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"manual choice is kept\", () => { pm.expect(j.category.name).to.eql(\"Shopping\"); pm.expect(j.category_source).to.eql(\"user\"); });"
                ]
              }
            }
          ]
        },
        {
