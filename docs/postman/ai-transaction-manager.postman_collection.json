          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"10 default categories\", () => { pm.expect(j.length).to.eql(10); });",
                  "const id = n => j.find(c => c.name === n).id;",
                  "pm.collectionVariables.set(\"foodId\", id(\"Food\")); pm.collectionVariables.set(\"shoppingId\", id(\"Shopping\")); pm.collectionVariables.set(\"salaryId\", id(\"Salary\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
